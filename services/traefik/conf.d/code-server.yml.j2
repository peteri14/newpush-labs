http:
  middlewares:
    sablier-dynamic-code-server:
      plugin:
        sablier:
          names: lab-code-server
          dynamic:
            displayName: Code Server
            refreshFrequency: 5s
            showDetails: "true"
            theme: ghost
          sablierUrl: http://sablier:10000
          sessionDuration: 5m
    code-server-strip-prefix:
      stripPrefix:
        prefixes:
          - "/labs/code-server/"
    code-redirect:
      redirectRegex:
        regex: "^(.*)/labs/code-server$$"
        replacement: "${1}/labs/code-server/"
  services:
    code-server:
      loadBalancer:
        servers:
          - url: "http://lab-code-server:8443"
  routers:
    code-server:
      rule: "Host(`www.{{ lab_external_ip }}.ai-campus.hu`) && PathPrefix(`/labs/code-server`)"
      entryPoints:
        - "https"
      middlewares:
        - sablier-dynamic-code-server@file
        - code-server-strip-prefix@file
        - code-redirect@file
        - traefik-forward-auth@file
      service: "code-server"
      priority: 100
      tls:
        certResolver: default
