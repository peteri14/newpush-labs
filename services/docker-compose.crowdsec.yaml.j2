services:
  crowdsec:
    image: crowdsecurity/crowdsec:${CROWDSEC_VERSION:-latest}
    container_name: crowdsec
    restart: unless-stopped
    environment:
      COLLECTIONS: crowdsecurity/traefik crowdsecurity/linux crowdsecurity/iptables
      CUSTOM_HOSTNAME: crowdsec
      BOUNCER_KEY_TRAEFIK: {{ shared_key_for_crowdsec_traefik }}
      BOUNCER_KEY_FIREWALL: {{ shared_key_for_crowdsec_firewall }}
    volumes:
      - ./crowdsec/profiles.yaml:/etc/crowdsec/profiles.yaml:ro
      - ./crowdsec/acquis.yaml:/etc/crowdsec/acquis.yaml:ro
      - ./crowdsec/data:/var/lib/crowdsec/data/
      - ./crowdsec/etc:/etc/crowdsec/
      - /var/log/:/var/log
      - ./traefik/logs:/var/log/traefik
    labels:
      - traefik.enable=false
    networks:
      - web
    ports:
      - 127.0.0.1:9580:8080
networks:
  web:
    external: True
