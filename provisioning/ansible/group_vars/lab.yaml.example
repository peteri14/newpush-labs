---
ansible_python_interpreter: /usr/bin/python3

lab_dir: /opt/student-lab

# casdoor settings
organization_display_name: "PTE-MIK lab"
organization_url: "https://mik.pte.hu"
organization_logo: "https://images.neo.mik.pte.hu:8000/pte.png"
background_url: "https://images.neo.mik.pte.hu:8000/background.jpg"
admin_user_password: "hacker"


# create a free account on zerossl.com to get these values
acme_email: example@example.com
acme_zerossl_hmac_encoded: 
acme_zerossl_kid: 

traefik_crowdsec_bouncer: true
shared_key_for_crowdsec_traefik:
shared_key_for_crowdsec_firewall:

# Required for the CrowdSec plugin for Traefik.
# If not present, bots will receive an HTTP error code instead of a CAPTCHA challenge.
hcaptcha_site_key: 
# The account key is also required for correct working operation
hcaptcha_account_key: 



# bring your own keys 
openai_api_key: 
anthropic_api_key: 
groq_api_key: 

# the name of the application in the casdoor
generic_oauth_application_name: application 
# if OAUTH secret and ID is not defined here, then it is automatically generated
# generic_oauth_client_id: 5e7c01af6d262109e111 
# generic_oauth_client_secret:  

# Base DNS zone used when lab_domain is left unset.
# Used only when lab_domain is unset. The derived lab_domain will be: <lab_external_ip>.<lab_domain_zone>
lab_domain_zone: ai-campus.hu

# Optional full domain override. If set, this value wins everywhere.
# lab_domain:

# Optional external IP. Required only when lab_domain is unset; otherwise inferred from
# an IP-based domain such as 1.2.3.4.example.com when possible.
# If lab_domain is unset and this is blank, it is detected automatically with ifconfig.me.
lab_external_ip:

# WeTTY host terminal access uses a dedicated SSH key generated under
# {{ lab_dir }}/services/wetty/ssh and authorized for lab_user.
# The lab user is granted passwordless sudo through /etc/sudoers.d.
# The SSH port is detected from the active Ansible connection/sshd config.
# Optional override, only if auto-detection is not suitable:
# lab_wetty_ssh_port: 45522

# Lab system identity.
# By default, an existing account/group with lab_uid/lab_gid is reused.
# Set lab_user_force or lab_group_force to true only if you want to create/use the named identity even when UID/GID already exists.
lab_uid: 1000
lab_gid: 1000
lab_user: labuser
lab_group: labuser
# lab_user_force: false
# lab_group_force: false

# Default system locale
locale_encoding: UTF-8
locale_language: en_US
locale_language_all: en_US:en
locale_origin: en_US
locale_time: C
system_timezone: Etc/UTC

# Set to true when provisioning with Vagrant
is_vagrant: false
